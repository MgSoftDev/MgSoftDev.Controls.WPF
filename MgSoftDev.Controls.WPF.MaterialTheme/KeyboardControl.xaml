                                                Command="{TemplateBinding KeyPressCommand}" VerticalAlignment="Stretch"
                                                HorizontalAlignment="Stretch" Margin="5"
                                                Focusable="False" Height="Auto" Width="Auto"
                                                Style="{DynamicResource MaterialDesignRaisedButton}">
                                            <TextBlock Text="Enter"
                                                       Style="{StaticResource MaterialDesignSubtitle1TextBlock}" />
                                        </Button>
    
                                        <Button Grid.Row="2" Grid.Column="2" CommandParameter="KEY_1"
                                                Command="{TemplateBinding KeyPressCommand}" Margin="5"
                                                Focusable="False" Height="Auto" Width="Auto"
                                                Style="{DynamicResource MaterialDesignRaisedButton}">
                                            <TextBlock Text="1" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" />
                                        </Button>
                                        <Button Grid.Row="2" Grid.Column="3" CommandParameter="KEY_2"
                                                Command="{TemplateBinding KeyPressCommand}" Margin="5"
                                                Focusable="False" Height="Auto" Width="Auto"
                                                Style="{DynamicResource MaterialDesignRaisedButton}">
                                            <TextBlock Text="2" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" />
                                        </Button>
                                        <Button Grid.Row="2" Grid.Column="4" CommandParameter="KEY_3"
                                                Command="{TemplateBinding KeyPressCommand}" Margin="5"
                                                Focusable="False" Height="Auto" Width="Auto"
                                                Style="{DynamicResource MaterialDesignRaisedButton}">
                                            <TextBlock Text="3" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" />
                                        </Button>
    
    
                                        <Button Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" CommandParameter="KEY_0"
                                                Command="{TemplateBinding KeyPressCommand}" Margin="5"
                                                Focusable="False" Height="Auto" Width="Auto"
                                                Style="{DynamicResource MaterialDesignRaisedButton}">
                                            <TextBlock Text="0" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" />
                                        </Button>
                                        <Button Grid.Row="3" Grid.Column="4" CommandParameter="SUBTRACT"
                                                Command="{TemplateBinding KeyPressCommand}" Margin="5"
                                                Focusable="False" Height="Auto" Width="Auto"
                                                Style="{DynamicResource MaterialDesignRaisedButton}">
                                            <TextBlock Text="-" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" />
                                        </Button>
                                        <Button Grid.Row="3" Grid.Column="6" CommandParameter="LEFT"
                                                Command="{TemplateBinding KeyPressCommand}" Margin="5"
                                                Content="{materialDesign:PackIcon ArrowLeftBold, Size=20}"
                                                Focusable="False" Height="Auto" Width="Auto"
                                                Style="{DynamicResource MaterialDesignRaisedButton}" />
                                        <Button Grid.Row="3" Grid.Column="7" CommandParameter="RIGHT"
                                                Command="{TemplateBinding KeyPressCommand}" Margin="5"
                                                Focusable="False" Height="Auto" Width="Auto"
                                                Style="{DynamicResource MaterialDesignRaisedButton}"
                                                Content="{materialDesign:PackIcon ArrowRightBold, Size=20}" />
                                        <!--<Button Grid.Row="3" Grid.Column="4" Grid.ColumnSpan="3" CommandParameter="SPACE_BAR"
                                                Command="{TemplateBinding KeyPressCommand}" Margin="5"
                                                Focusable="False" Height="Auto" Width="Auto"   Style="{DynamicResource MaterialDesignRaisedButton}">
                                            <TextBlock Text="Espacio" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" />
                                        </Button>-->
    
                                    </Grid>
                                </StackPanel>
                            </Grid>
    
                        </materialDesign:Card>
                        <ControlTemplate.Triggers>
                            <Trigger Property="CapsLook" Value="True">
                                <Setter Property="Background" Value="{StaticResource MaterialDesign.Brush.Primary.Light}"
                                        TargetName="CapsLookLeft" />
                                <Setter Property="Background" Value="{StaticResource MaterialDesign.Brush.Primary.Light}"
                                        TargetName="CapsLookRight" />
                            </Trigger>
                            <Trigger Property="ChangeToNumeric" Value="True">
                                <Setter TargetName="Alphanumeric1" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Alphanumeric2" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="Scope" Value="Calculator">
                                <Setter TargetName="ScopeCalculator" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ScopeAlphanumeric" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="Scope" Value="Decimal">
                                <Setter TargetName="ScopeDecimal" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ScopeAlphanumeric" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="Scope" Value="Numeric">
                                <Setter TargetName="ScopeNumeric" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ScopeAlphanumeric" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

</ResourceDictionary>